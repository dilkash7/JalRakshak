# JalRakshak Environment Variables
# Copy to .env.local for local overrides. Never commit .env.local to Git.

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication (Auth.js / NextAuth / JWT)
# Generate a secret: openssl rand -base64 32
AUTH_SECRET=your_auth_secret_minimum_32_characters_here
NEXTAUTH_SECRET=your_auth_secret_minimum_32_characters_here
NEXTAUTH_URL=http://localhost:3000

# Seed Script Initial Administrator (Read by npm run seed)
ADMIN_NAME="Administrator"
ADMIN_EMAIL="admin@jalrakshak.org"
ADMIN_PASSWORD="ReplaceWithAStrongAdminPassword123!"

# MongoDB Database (Optional for local dev, uses resilient in-memory fallback if omitted)
# For production: mongodb+srv://<user>:<password>@cluster0.example.mongodb.net/jalrakshak?retryWrites=true&w=majority
MONGODB_URI=

# Cloudinary (Optional for local dev, uses local asset handler if omitted)
# Required in production for signed image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Upstash Redis (Optional for local dev, uses in-memory token bucket if omitted)
# Required in production for distributed rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
