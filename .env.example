# JalRakshak — Environment Configuration
# NOTE: JalRakshak is a fully browser-local prototype.
# ZERO environment variables are required to run locally or deploy to Vercel.
# The application uses browser localStorage for records and IndexedDB for photographs.

# Application URL (Optional, defaults to current origin in browser)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node Environment
NODE_ENV=development
